{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "plugins": [
    "./tui-plugins/workflow-ui.tsx",
    "./herdr-tui-session.js"
  ],
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "attention": {
    "notifications": true,
    "sound": false,
    "volume": 0.4
  },
  "mouse": true,
  "cursor": {
    "style": "block",
    "blinking": true
  }
}
