{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================
  // Free-only routing: one build worker + one reviewer
  // ============================================================
  // DeepSeek V4.1 Flash Free accepts text and images, supports tool calls and
  // reasoning variants, and needs no paid provider credentials.
  "model": "opencode/deepseek-v4.1-flash-free",
  "default_agent": "build",

  // === Quality of life ===
  "formatter": true,
  "share": "disabled",
  "update": "disable",

  // === Context control ===
  // Keep a reserved budget for the compaction summary so large tool output
  // does not crowd out the rest of the conversation.
  "compaction": {
    "auto": true,
    "buffer": 10000
  },

  // === Watcher ignore ===
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".next/**",
      ".turbo/**",
      "target/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      ".cache/**",
      ".git/**"
    ]
  },

  // === Global permissions ===
  // Native V2 ordered rules: the last matching rule wins.
  // Normal coding, routine git, package installations, web research, and
  // external directories are autonomous. Destructive actions (rm, sudo,
  // reset --hard), secrets, and process termination require approval.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs *", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "chgrp *", "effect": "ask" },

    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "git remote remove *", "effect": "ask" },

    { "action": "shell", "resource": "pkill *", "effect": "ask" },
    { "action": "shell", "resource": "killall *", "effect": "ask" },
    { "action": "shell", "resource": "kill -9 *", "effect": "ask" },

    { "action": "shell", "resource": "env", "effect": "ask" },
    { "action": "shell", "resource": "env *", "effect": "ask" },
    { "action": "shell", "resource": "printenv", "effect": "ask" },
    { "action": "shell", "resource": "printenv *", "effect": "ask" },
    { "action": "shell", "resource": "cat *.env", "effect": "ask" },
    { "action": "shell", "resource": "cat *.env.*", "effect": "ask" },
    { "action": "shell", "resource": "head *.env", "effect": "ask" },
    { "action": "shell", "resource": "head *.env.*", "effect": "ask" },
    { "action": "shell", "resource": "tail *.env", "effect": "ask" },
    { "action": "shell", "resource": "tail *.env.*", "effect": "ask" },
    { "action": "shell", "resource": "less *.env", "effect": "ask" },
    { "action": "shell", "resource": "less *.env.*", "effect": "ask" },
    { "action": "shell", "resource": "more *.env", "effect": "ask" },
    { "action": "shell", "resource": "more *.env.*", "effect": "ask" },
    { "action": "shell", "resource": "grep *.env", "effect": "ask" },
    { "action": "shell", "resource": "grep *.env.*", "effect": "ask" },
    { "action": "shell", "resource": "rg *.env", "effect": "ask" },
    { "action": "shell", "resource": "rg *.env.*", "effect": "ask" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "*.key", "effect": "ask" },
    { "action": "read", "resource": "*id_rsa*", "effect": "ask" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },

    // Only the free reviewer may be launched as a subagent.
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "reviewer", "effect": "allow" }
  ],

  // === Agents ===
  // Keep a single build worker and a single reviewer. Built-in routes that
  // would bypass this setup are disabled.
  "agents": {
    "build": {
      "model": "opencode/deepseek-v4.1-flash-free#high"
    },
    "plan": { "disabled": true },
    "general": { "disabled": true },
    "explore": { "disabled": true }
  },

  "shell": "fish"
}
