{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "ask",
      "*.key": "ask",
      "*.p12": "ask",
      "*.pfx": "ask",
      "*id_rsa*": "ask",
      "*id_ed25519*": "ask",
      "~/.ssh/*": "ask",
      "~/.config/pi/auth.json": "deny",
      "~/.npmrc": "ask",
      "~/.netrc": "ask"
    },
    "read": "allow",
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git branch --show-current": "allow",
      "git branch --list *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git grep *": "allow",
      "git describe *": "allow",
      "git shortlog *": "allow",
      "git tag --list *": "allow",
      "echo \"---\"": "allow",
      "echo '---'": "allow",
      "echo ---": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "tree *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "test *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "uname *": "allow",
      "sw_vers": "allow",
      "whoami": "allow",
      "id": "allow",
      "date": "allow",
      "uptime": "allow",
      "hostname": "allow",
      "git --version": "allow",
      "node --version": "allow",
      "npm --version": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "fish --version": "allow",
      "zsh --version": "allow",
      "sudo *": "ask",
      "rm *": "ask",
      "dd *": "ask",
      "mkfs *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "chgrp *": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git branch -D *": "ask",
      "git stash drop *": "ask",
      "git remote remove *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "kill -9 *": "ask",
      "env": "ask",
      "env *": "ask",
      "printenv": "ask",
      "printenv *": "ask"
    },
    "mcp": {
      "*": "ask"
    },
    "skill": {
      "*": "ask"
    },
    "external_directory": {
      "*": "ask"
    }
  }
}
