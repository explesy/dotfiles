{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": true,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "~/.ssh/*": "deny",
      "~/.config/pi/auth.json": "deny",
      "~/.npmrc": "deny",
      "~/.netrc": "deny"
    },
    "read": "allow",
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask"
    },
    "mcp": {
      "*": "ask"
    },
    "skill": {
      "*": "ask"
    },
    "external_directory": {
      "*": "ask"
    }
  }
}
