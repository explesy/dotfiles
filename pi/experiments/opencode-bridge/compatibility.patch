+/** OpenCode v2 loads location configuration after its first API response. */
+export async function waitForBridgeAgent(dir: string, signal?: AbortSignal): Promise<void> {
+  const directory = await realpath(dir);
+  const endpoint = `/api/agent?location%5Bdirectory%5D=${encodeURIComponent(directory)}`;
+  const deadline = Date.now() + DISCOVERY_TIMEOUT_MS;
+  while (Date.now() < deadline) {
+    signal?.throwIfAborted();
+    const result = await runCapture(["api", "GET", endpoint], undefined, DISCOVERY_TIMEOUT_MS, directory);
+    if (result.code !== 0) throw new Error("OpenCode agent readiness check failed");
+    const payload = JSON.parse(result.stdout);
+    const agent = payload.data?.find((item: { id: string }) => item.id === AGENT_ID);
+    if (agent && payload.location?.directory === directory) {
+      const permissions = agent.permissions as { action: string; resource: string; effect: string }[];
+      const lastWildcard = permissions?.findLastIndex((rule) => rule.action === "*" && rule.resource === "*") ?? -1;
+      if (lastWildcard >= 0 && permissions.slice(lastWildcard).every((rule) => rule.effect === "deny")) return;
+    }
+    await delay(200, undefined, { signal });
+  }
+  throw new Error("OpenCode bridge agent was not ready before the startup deadline");
 }
 
