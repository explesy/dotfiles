#!/usr/bin/env zsh
set -euo pipefail

export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.config/pi}"

readonly PI_BIN="/opt/homebrew/bin/pi"
readonly EXTENSION_ROOT="$PI_CODING_AGENT_DIR/npm/node_modules"

# An explicitly named unrestricted base mode. Keep the Herdr extensions out:
# their tool schemas are rejected by the Console Go provider.
exec "$PI_BIN" \
  --no-extensions \
  --extension "$EXTENSION_ROOT/@zhcsyncer/pi-recap/extensions/recap.ts" \
  --extension "$PI_CODING_AGENT_DIR/extensions/workflow.ts" \
  "$@"
