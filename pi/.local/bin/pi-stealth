#!/usr/bin/env zsh
set -euo pipefail

export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.config/pi}"
readonly COMPOSE_FILE="$PI_CODING_AGENT_DIR/stealth/compose.yml"
readonly DATA_DIR="$HOME/.local/share/pi-stealth"

if ! command -v docker >/dev/null 2>&1; then
  print -u2 "Docker is required. Install/start Docker Desktop first."
  exit 1
fi

if [[ ! -f "$COMPOSE_FILE" ]]; then
  print -u2 "Stealth compose file not found: $COMPOSE_FILE"
  exit 1
fi

mkdir -p "$DATA_DIR"/{cache,mcp,profile}

action="${1:-status}"

case "$action" in
  up|start)
    docker compose -f "$COMPOSE_FILE" up -d --build
    print
    print "Stealth browser backend started."
    print "Pi MCP endpoint: http://127.0.0.1:8766/mcp"
    print "Run: pi mcp list"
    ;;
  down|stop)
    docker compose -f "$COMPOSE_FILE" down
    ;;
  restart)
    docker compose -f "$COMPOSE_FILE" down
    docker compose -f "$COMPOSE_FILE" up -d --build
    ;;
  logs)
    shift || true
    docker compose -f "$COMPOSE_FILE" logs -f "$@"
    ;;
  status)
    docker compose -f "$COMPOSE_FILE" ps
    ;;
  rebuild)
    docker compose -f "$COMPOSE_FILE" build --no-cache
    docker compose -f "$COMPOSE_FILE" up -d
    ;;
  *)
    print -u2 "Usage: pi-stealth {up|down|restart|status|logs|rebuild}"
    exit 2
    ;;
esac
