#!/usr/bin/env zsh
set -euo pipefail

readonly PI_PACKAGE="@earendil-works/pi-coding-agent"
readonly PI_CONFIG_DIR="${PI_CODING_AGENT_DIR:-$HOME/.config/pi}"
readonly PI_NPM_DIR="$PI_CONFIG_DIR/npm"
readonly HOMEBREW_NPM="/opt/homebrew/bin/npm"
readonly HOMEBREW_NODE="/opt/homebrew/bin/node"

verify_pi() {
  local pi_version
  pi_version="$(pi --version)"
  print "Pi: $pi_version"
  "$HOMEBREW_NODE" - "$PI_NPM_DIR" "$pi_version" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const [root, cliVersion] = process.argv.slice(2);
try {
  const manifest = JSON.parse(fs.readFileSync(path.join(root, "package.json"), "utf8"));
  const names = ["pi-agent-core", "pi-ai", "pi-coding-agent", "pi-tui"];
  const errors = [];
  for (const name of names) {
    const fullName = `@earendil-works/${name}`;
    const pinned = manifest.devDependencies?.[fullName];
    if (!/^\d+\.\d+\.\d+$/.test(pinned ?? "")) {
      errors.push(`${fullName}: expected an exact SDK version in devDependencies`);
      continue;
    }
    const installed = JSON.parse(fs.readFileSync(path.join(root, "node_modules", fullName, "package.json"), "utf8")).version;
    if (pinned !== cliVersion || installed !== pinned) {
      errors.push(`${fullName}: manifest=${pinned}, installed=${installed}, CLI=${cliVersion}`);
    }
  }
  if (errors.length) {
    console.error("Pi compatibility check failed:\n" + errors.join("\n"));
    console.error("Align the managed SDK pins with Pi, then install dependencies in " + root + ".");
    process.exitCode = 1;
  } else {
    console.log("Pi CLI and all four managed SDK versions agree.");
  }
} catch (error) {
  console.error("Pi compatibility check failed: " + error.message);
  process.exitCode = 1;
}
NODE
  cd "$PI_NPM_DIR"
  "$HOMEBREW_NPM" ls --depth=0
}

if [[ "${1:-}" == "--check" ]]; then
  if (( $# > 1 )); then
    print -u2 "Usage: pi-update [--check]"
    exit 2
  fi

  verify_pi
  exit 0
elif (( $# > 0 )); then
  print -u2 "Usage: pi-update [--check]"
  exit 2
fi

print "== Updating Pi =="

if [[ "$(uname -s)" != "Darwin" ]]; then
  print -u2 "pi-update currently supports macOS only."
  exit 1
fi

if (( $+commands[brew] )) && brew list --formula --versions pi-coding-agent >/dev/null 2>&1; then
  print "Pi is managed by Homebrew; upgrading pi-coding-agent."
  brew upgrade pi-coding-agent
else
  if [[ ! -x "$HOMEBREW_NPM" ]]; then
    print -u2 "Homebrew npm was not found at $HOMEBREW_NPM."
    exit 1
  fi

  print "Pi is managed by the Homebrew npm prefix; installing the latest npm package."
  "$HOMEBREW_NPM" install -g --ignore-scripts "$PI_PACKAGE@latest"
fi

if [[ ! -f "$PI_NPM_DIR/package.json" ]]; then
  print -u2 "Pi extension manifest was not found: $PI_NPM_DIR/package.json"
  exit 1
fi

print "== Updating Pi extensions =="
cd "$PI_NPM_DIR"
"$HOMEBREW_NPM" install --ignore-scripts

print "== Verification =="
rehash
verify_pi
