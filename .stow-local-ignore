# Never stow generated/package state (stays on disk, not linked)
opencode/\.config/opencode/node_modules
opencode/\.config/opencode/bun\.lock

# Package READMEs are documentation, not config: never link into $HOME
^README\.md$

# OS artifacts
\.DS_Store

# Editor & runtime logs
.*\.log$
\.nvimlog

# Backup & ephemeral files
.*\.bak$
.*\.toml-[0-9]+$
karabiner/\.config/karabiner/automatic_backups
fish/\.config/fish/fish_variables