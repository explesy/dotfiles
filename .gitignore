# OS artifacts
**/.DS_Store

# Editor & runtime logs
*.log
*.swp
*~
.nvimlog

# Backup & ephemeral files
**/*.bak
zellij/.config/zellij/config.kdl.bak
yazi/.config/yazi/*.toml-*
karabiner/.config/karabiner/automatic_backups/*.json

# Runtime & local state
fish/.config/fish/fish_variables
herdr/.config/herdr/*.bak
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock

# Runtime dependencies (generated locally, never committed)
node_modules/
**/node_modules/
opencode/.config/opencode/bun.lock

# Pi runtime and credentials (the tracked package contains only portable config).
pi/.config/pi/auth.json
pi/.config/pi/models-store.json
pi/.config/pi/sessions/
pi/.config/pi/pi-herdsman/
pi/.config/pi/npm/node_modules/
pi/.config/pi/extensions/*/state/
pi/.config/pi/extensions/*/_tmp/
pi/.config/pi/extensions/*/logs/
